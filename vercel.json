{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!css|js|images|favicon.ico).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.bgcaribe.mx"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/((?!css|js|images|favicon.ico).*)",
      "has": [
        {
          "type": "host",
          "value": "confirmacion.bgcaribe.mx"
        }
      ],
      "destination": "/confirmacion.html"
    }
  ]
}
